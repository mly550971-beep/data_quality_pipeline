# =========================
# DATABASE
# =========================
# sqlite أو postgresql
DATABASE_TYPE=sqlite

SQLITE_DB_PATH=enterprise_quality.db

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=data_quality
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# يمكن تركه فارغاً لاكتشاف كل الجداول:
DB_TABLES=

# =========================
# TESSERACT OCR
# =========================
# Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#
# Linux:
# TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=

# eng أو ara+eng بعد تثبيت اللغة العربية في Tesseract
OCR_LANG=eng

OCR_MIN_CONFIDENCE=45
OCR_MIN_TEXT_LENGTH=5

# =========================
# ANOMALY DETECTION
# =========================
Z_SCORE_THRESHOLD=3.0
IQR_MULTIPLIER=1.5

# =========================
# EMAIL
# =========================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_SUBJECT=Enterprise Data Quality & OCR Observability Report
